    def mime(self) -> str | None: ...
    @property
    def mediatype(self) -> str | None: ...
    @property
    def sha1(self) -> str | None: ...
    @property
    def timestamp(self) -> str | None: ...
    @property
    def user(self) -> str | None: ...
    def __getattr__(self, name: str) -> Any: ...
