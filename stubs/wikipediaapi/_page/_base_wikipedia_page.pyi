import abc
from abc import ABC, abstractmethod
from typing import Any, Generic, TypeVar

from _typeshed import Incomplete

from .._enums import Namespace as Namespace
from .._enums import WikiNamespace as WikiNamespace
from .._enums import namespace2int as namespace2int
from .wikipedia_page_section import WikipediaPageSection as WikipediaPageSection

PageT = TypeVar("PageT", bound="BaseWikipediaPage[Any]")

class _Sentinel:
    def __new__(cls) -> _Sentinel: ...
    def __bool__(self) -> bool: ...

NOT_CACHED: Incomplete

class BaseWikipediaPage(ABC, Generic[PageT], metaclass=abc.ABCMeta):
    ATTRIBUTES_MAPPING: dict[str, list[str]]
    wiki: Incomplete
    def __init__(
        self,
        wiki: Any,
        title: str,
        ns: WikiNamespace = ...,
        language: str = "en",
        variant: str | None = None,
        url: str | None = None,
    ) -> None: ...
    @property
    def language(self) -> str: ...
    @property
    def variant(self) -> str | None: ...
    @property
    def title(self) -> str: ...
    @property
    def ns(self) -> int: ...
    @property
    def namespace(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    @property
    @abstractmethod
    def sections(self) -> list[WikipediaPageSection]: ...
    @abstractmethod
    def exists(self) -> Any: ...
    def __getattribute__(self, name: str) -> Any: ...
    def __getattr__(self, name: str) -> Any: ...
    def sections_by_title(self, title: str) -> list[WikipediaPageSection]: ...
    def section_by_title(self, title: str) -> WikipediaPageSection | None: ...
